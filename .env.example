# ============================================================================
# LLM Provider & Self-Hosted LLM Gateway Configuration (llm-gateway-sdk)
# ============================================================================
# Supported providers: "litellm" (default gateway aliases), "openai", "gemini"
LLM_PROVIDER=litellm

# Self-hosted LLM Gateway endpoint & issued virtual key (ticket-classification-key)
LLM_GATEWAY_BASE_URL=https://82.70.210.36.sslip.io/v1
LLM_GATEWAY_API_KEY=sk-your-ticket-classification-virtual-key

# Default capability aliases or provider-specific models
# - Gateway aliases: general-fast, general-reasoning, structured-output, agent-tools, rag-embedding
# - OpenAI models:   gpt-4o-mini, gpt-4o, text-embedding-3-small
# - Gemini models:   gemini-3.8-flash, gemini-4-argon, gemini-embedding-001
LLM_GATEWAY_DEFAULT_MODEL=general-fast
LLM_GATEWAY_DEFAULT_EMBEDDING_MODEL=rag-embedding
LLM_GATEWAY_EMBEDDING_DIMENSIONS=1536

# Optional attribution & operational settings
LLM_GATEWAY_APP_NAME=ticket-classification
LLM_GATEWAY_ENVIRONMENT=development
LLM_GATEWAY_TIMEOUT=60.0
LLM_GATEWAY_MAX_RETRIES=0

# Optional per-tier overrides (CHEAP, STANDARD, STRONG)
LLM_TIERING_ENABLED=true
LLM_TIER_CHEAP_MODEL=
LLM_TIER_STANDARD_MODEL=
LLM_TIER_STRONG_MODEL=

# Optional direct provider keys (ONLY used if bypass_gateway=true in direct provider mode)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
