APP_ENV=production
AUTH_ENABLED=true
API_DOCS_ENABLED=false
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
CONFIG_PATH=configs/pipeline_config.yaml
DATA_DIR=/data
DOMAIN_ID=generic
TENANT_ID=default
AUTH_TOKENS_FILE=secrets/auth_tokens.json
ARTIFACT_HMAC_SECRET_FILE=secrets/artifact_hmac
GATEWAY_KEY_FILE=secrets/gateway_key
LLM_PROVIDER=litellm
LLM_GATEWAY_BASE_URL=https://gateway.example.com/v1
LLM_GATEWAY_DEFAULT_MODEL=general-fast
LLM_GATEWAY_DEFAULT_EMBEDDING_MODEL=rag-embedding
LLM_GATEWAY_EMBEDDING_DIMENSIONS=1536
LLM_GATEWAY_APP_NAME=ticket-classification
LLM_GATEWAY_ENVIRONMENT=production
LLM_GATEWAY_TIMEOUT=60.0
LLM_GATEWAY_MAX_RETRIES=0
EMBEDDING_REVISION=
EMBEDDING_TASK=clustering
FIT_JOB_MAX_ATTEMPTS=3
